DEFINE_INSN_IF(SUPPORT_JOKE)
bitblt
()
()
(VALUE ret)
{
    ret = rb_str_new2("a bit of bacon, lettuce and tomato");
}

/* The Answer to Life, the Universe, and Everything */
DEFINE_INSN_IF(SUPPORT_JOKE)
answer
()
()
(VALUE ret)
{
    ret = INT2FIX(42);
}

/* ++++++++++++++++++ Specialized IR insns: ++++++++++++++++++ */

DEFINE_INSN
sir_branch
(OFFSET tdst, OFFSET fdst)
(VALUE val)
()
/* Same discussion as jump. */
// attr bool leaf = leafness_of_check_ints; /* has rb_threadptr_execute_interrupts() */
{
    RUBY_VM_CHECK_INTS(ec);
    RTEST(val) ? JUMP(tdst) : JUMP(fdst);
}

DEFINE_INSN
sir_jump
(OFFSET dst)
()
()
/* Same discussion as jump. */
// attr bool leaf = leafness_of_check_ints; /* has rb_threadptr_execute_interrupts() */
{
    RUBY_VM_CHECK_INTS(ec);
    JUMP(dst);
}

DEFINE_INSN
sir_branchnil
(OFFSET nil_dst, OFFSET else_dst)
(VALUE val)
()
/* Same discussion as jump. */
// attr bool leaf = leafness_of_check_ints; /* has rb_threadptr_execute_interrupts() */
{
    RUBY_VM_CHECK_INTS(ec);
    JUMP(NIL_P(val) ? nil_dst : else_dst);
}

/* push inline-cached value and go to dst if it is valid */
DEFINE_INSN
sir_getinlinecache
(OFFSET dst, OFFSET dst2, IC ic)
()
(VALUE val)
// attr bool leaf = leafness_of_check_ints; /* has rb_threadptr_execute_interrupts() */
{
    struct iseq_inline_constant_cache_entry *ice = ic->entry;
    if (ice && vm_ic_hit_p(ice, GET_EP())) {
        val = ice->value;
        JUMP(dst);
    }
    else {
	val = Qnil;
        JUMP(dst2);
    }
}

DEFINE_INSN
sir_mov
(EPDISP res, EPDISP op)
()
()
{
    VALUE v = *(GET_EP() + op);
    vm_env_write(GET_EP(), (int)res, v);
}

DEFINE_INSN
sir_movi
(EPDISP res, VALUE imm)
()
()
{
    vm_env_write(GET_EP(), (int)res, imm);
}

/* Set a local variable (pointed to by 'idx') as val in the current stack frame.
 */
DEFINE_INSN
sir_setlocal
(EPDISP idx)
(VALUE val)
()
{
    VM_STACK_ENV_WRITE(GET_EP(), (int)idx, val);
    RB_DEBUG_COUNTER_INC(lvar_set);
    (void)RB_DEBUG_COUNTER_INC_IF(lvar_set_dynamic, FALSE);
}

/* --- Type specialized insns: --- */
DEFINE_INSN
sir_iplussvv
(EPDISP op1, EPDISP op2)
()
(VALUE val)
{
    VALUE v1 = *(GET_EP() + op1), v2 = *(GET_EP() + op2);
    CHECK_INPUTS(NAME_OF_CURRENT_INSN, v1, v2);
    SIR_FUNC_NAME(NAME_OF_CURRENT_INSN)(&val, v1, v2);
    if (UNLIKELY(CHECK_RES_FUNC_NAME(NAME_OF_CURRENT_INSN)(val))) {
      safe_insn_restart:
        ABS_JUMP(rb_sir_get_safe_pc(GET_CFP(), reg_pc));
        TC_DISPATCH0();
    }
}

