DEFINE_INSN
specialize_bbv
(lindex_t bbv)
()
()
{
    struct rb_iseq_bbv *bbv_ref = (struct rb_iseq_bbv *)bbv;
    if (--bbv_ref->spec_count < 0) {
        VALUE *cont_pc = rb_sir_specialize_bbv(GET_CFP(), bbv_ref);
        SET_PC(cont_pc);
        ABNORMAL_END_INSN(specialize_bbv); /* to skip pc increase */
    }
}

