(lindex_t bbv)
()
()
{
    rb_rejit_bbv((struct rb_iseq_bbv *)bbv);
    ABNORMAL_END_INSN(sir_gen_bbv); /* to skip pc increase and start with the same insn address */
}

DEFINE_INSN
sir_gen_bbv
(lindex_t bbv, OFFSET origin)
()
()
/* Same discussion as leave. */
// attr bool leaf = leafness_of_check_ints; /* has rb_threadptr_execute_interrupts() */
/* It occurs only in bbv_encoded and can change sir insn addresses */
{
    VALUE *cont_pc = rb_sir_gen_bbv(GET_CFP(), (struct rb_iseq_bbv *)bbv, (int)origin, TRUE);
    SET_PC(cont_pc);
    ABNORMAL_END_INSN(sir_gen_bbv); /* to skip pc increase */
}

