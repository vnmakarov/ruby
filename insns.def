}

/* Get value of instance variable id of self. */
DEFINE_INSN
sir_getivar
(lindex_t index, lindex_t class_serial)
()
(VALUE val)
// attr bool leaf = false; /* has IVAR_ACCESSOR_SHOULD_BE_MAIN_RACTOR() */
{
    VALUE self = GET_SELF();
    if (class_serial != RCLASS_SERIAL(RBASIC(self)->klass)) goto sir_getivar_exit;
    VM_ASSERT(RB_TYPE_P(self, T_OBJECT));
    if (RB_FL_ANY_RAW(self, ROBJECT_EMBED)) {
        if (UNLIKELY(index >= ROBJECT_EMBED_LEN_MAX)) goto sir_getivar_exit;
        val = ROBJECT(self)->as.ary[index];
    } else {
        if (UNLIKELY(index >= ROBJECT(self)->as.heap.numiv)) goto sir_getivar_exit;
        val = ROBJECT(self)->as.heap.ivptr[index];
    }
    goto sir_getivar_end;
  sir_getivar_exit:
    ABS_JUMP(rb_sir_get_safe_pc(reg_cfp, reg_pc - 3));
    ABNORMAL_END_INSN(sir_getivar);
  sir_getivar_end:
    ;
}

/* Get value of instance variable id of self. */
DEFINE_INSN
sir_igetivar
(lindex_t index, lindex_t class_serial)
()
(VALUE val)
// attr bool leaf = false; /* has IVAR_ACCESSOR_SHOULD_BE_MAIN_RACTOR() */
{
    VALUE self = GET_SELF();
    if (class_serial != RCLASS_SERIAL(RBASIC(self)->klass)) goto sir_igetivar_exit;
    VM_ASSERT(RB_TYPE_P(self, T_OBJECT));
    if (RB_FL_ANY_RAW(self, ROBJECT_EMBED)) {
        if (UNLIKELY(index >= ROBJECT_EMBED_LEN_MAX)) goto sir_igetivar_exit;
        val = ROBJECT(self)->as.ary[index];
    } else {
        if (UNLIKELY(index >= ROBJECT(self)->as.heap.numiv)) goto sir_igetivar_exit;
        val = ROBJECT(self)->as.heap.ivptr[index];
    }
    if (FIXNUM_P(val)) goto sir_igetivar_end;
  sir_igetivar_exit:
    ABS_JUMP(rb_sir_get_safe_pc(reg_cfp, reg_pc - 3));
    ABNORMAL_END_INSN(sir_getivar);
  sir_igetivar_end:
    ;
}

/* Set value of instance variable id of self to val. */
DEFINE_INSN
sir_setivar
(lindex_t index, lindex_t class_serial)
(VALUE val)
()
// attr bool leaf = false; /* has rb_check_frozen_internal() */
{
    VALUE self = GET_SELF();
    if (class_serial != RCLASS_SERIAL(RBASIC(self)->klass)) goto sir_setivar_exit;
    VM_ASSERT(RB_TYPE_P(self, T_OBJECT));
    if (UNLIKELY(RB_OBJ_FROZEN_RAW(self))) goto sir_setivar_exit;
    VM_ASSERT(!rb_ractor_shareable_p(self));
    if (RB_FL_ANY_RAW(self, ROBJECT_EMBED)) {
        if (UNLIKELY(index >= ROBJECT_EMBED_LEN_MAX)) {
            rb_init_iv_list(self);
            goto sir_setivar2;
        }
        RB_OBJ_WRITE(self, &ROBJECT(self)->as.ary[index], val);
        goto sir_setivar_end;
    } else {
        if (UNLIKELY(index >= ROBJECT(self)->as.heap.numiv)) {
            rb_init_iv_list(self);
        }
      sir_setivar2:
        VM_ASSERT(!RB_FL_ANY_RAW(self, ROBJECT_EMBED));
        RB_OBJ_WRITE(self, &ROBJECT(self)->as.heap.ivptr[index], val);
    }
    goto sir_setivar_end;
  sir_setivar_exit:
    ABS_JUMP(rb_sir_get_safe_pc(reg_cfp, reg_pc - 3));
    ABNORMAL_END_INSN(sir_setivar);
  sir_setivar_end:
    ;
}

/* Specialized call of method without block created from make_sir_send:
   it should be iseq, not-tail call, no splat args, all leading args */
DEFINE_INSN
sir_iseq_send_without_block
(CALL_DATA cd, lindex_t bbv)
(...)
(VALUE val)
// attr bool handles_sp = true;
// attr rb_snum_t sp_inc = sp_inc_of_sendish(cd->ci);
// attr rb_snum_t comptime_sp_inc = sp_inc_of_sendish(ci);
{
    MIRJIT_CONST_PTR(struct rb_iseq_bbv *, bbv_ref, (struct rb_iseq_bbv *)bbv);
    MIRJIT_CONST_PTR(rb_iseq_t *, iseq, bbv_ref->iseq);
    MIRJIT_CONST_PTR(struct rb_iseq_constant_body *, body, iseq->body);
    MIRJIT_CONST_PTR(const struct rb_callcache *, cc, cd->cc);
    MIRJIT_CONST(int, argc, vm_ci_argc(cd->ci), "d");
    VALUE *argv = reg_cfp->sp - argc;
    VALUE recv = TOPN(argc);

    if (UNLIKELY(!vm_cc_class_check(cc, CLASS_OF(recv)))) goto sir_iseq_send_without_block_exit;
    MIRJIT_CONST_PTR(const struct rb_callable_method_entry_struct *, cme, vm_cc_cme(cc));
    VM_ASSERT(callable_method_entry_p(cme));
    reg_cfp->sp = argv - 1; /* poping args including recv (sp before leave) */
    MIRJIT_CONST_PTR(VALUE *, start_pc, body->bbv_code + bbv_ref->bbv_start);
    MIRJIT_CONST(int, local_size, body->local_table_size - argc, "d");
    MIRJIT_CONST(int, stack_max, body->stack_max, "d");
    vm_push_frame_1(ec, iseq, VM_FRAME_MAGIC_METHOD | VM_ENV_FLAG_LOCAL, recv,
                    VM_BLOCK_HANDLER_NONE, (VALUE)cme, start_pc,
                    argv + argc, local_size, stack_max);
    RESTORE_REGS();
    NEXT_INSN();
  sir_iseq_send_without_block_exit:
    /* invalidate the current cc as we use cc from safe SIR: */
    if (cc != vm_cc_empty()) vm_cc_invalidate(cc);
    ABS_JUMP(rb_sir_get_safe_pc(reg_cfp, reg_pc - 3));
    ABNORMAL_END_INSN(sir_iseq_send_without_block);
}

/* Specialized call of method without block created from make_sir_send:
   it should be iseq, not-tail call, no splat args, all leading args  */
DEFINE_INSN
sir_send_ivget
(VALUE klass, lindex_t index)
(...)
(VALUE val)
// attr bool handles_sp = true;
// attr rb_snum_t sp_inc = 0;
// attr rb_snum_t comptime_sp_inc = 0;
{
    VALUE recv = TOPN(0);

    if (klass != CLASS_OF(recv)) goto sir_send_ivget_exit;
    VM_ASSERT(RB_TYPE_P(recv, T_OBJECT));
    if (LIKELY(index < ROBJECT_NUMIV(recv))) {
        reg_cfp->sp--; /* poping recv */
        val = ROBJECT_IVPTR(recv)[index];
        goto sir_send_ivget_end;
    }
  sir_send_ivget_exit:
    ABS_JUMP(rb_sir_get_safe_pc(reg_cfp, reg_pc - 3));
    ABNORMAL_END_INSN(sir_opt_ivget);
  sir_send_ivget_end:
    ;
}

/* Specialized call of method without block created from make_sir_send:
   it should be iseq, not-tail call, no splat args, all leading args  */
DEFINE_INSN
sir_send_ivset
(VALUE klass, lindex_t index)
(...)
(VALUE val)
// attr bool handles_sp = true;
// attr rb_snum_t sp_inc = -1;
// attr rb_snum_t comptime_sp_inc = -1;
{
    VALUE recv = TOPN(1);

    if (klass != CLASS_OF(recv)) goto sir_send_ivset_exit;
    VM_ASSERT(RB_TYPE_P(recv, T_OBJECT));
    val = TOPN(0);
    if (LIKELY(!RB_OBJ_FROZEN_RAW(recv))) { /* to exlude more of rb_check_frozen_internal */
        VM_ASSERT(!rb_ractor_shareable_p(recv));
        reg_cfp->sp -= 2; /* poping arg and recv */
        if (UNLIKELY(index >= ROBJECT_NUMIV(recv))) {
            rb_init_iv_list(recv);
        }
        VALUE *ptr = ROBJECT_IVPTR(recv);
        RB_OBJ_WRITE(recv, &ptr[index], val);
        goto sir_send_ivset_end;
    }
  sir_send_ivset_exit:
    ABS_JUMP(rb_sir_get_safe_pc(reg_cfp, reg_pc - 3));
    ABNORMAL_END_INSN(sir_send_ivset);
  sir_send_ivset_end:
    ;
}

/* Non-specialized call of method without block created from sir_make_send */
DEFINE_INSN
sir_send_without_block
(CALL_DATA cd, lindex_t dummy)
(...)
(VALUE val)
// attr bool handles_sp = true;
// attr rb_snum_t sp_inc = sp_inc_of_sendish(cd->ci);
// attr rb_snum_t comptime_sp_inc = sp_inc_of_sendish(ci);
{
    val = vm_sendish(ec, GET_CFP(), cd, VM_BLOCK_HANDLER_NONE, mexp_search_method);

    if (val == Qundef) {
        RESTORE_REGS();
        NEXT_INSN();
    } else if (GET_PC() != GET_CFP()->pc) {
        /* we need to restore pc here as vm_sendish can redefine a
           method and we invalidate the current bbv and switched to
           safe pc. */
        SET_PC(GET_CFP()->pc);
    }
}

/* Specialized call of method with block created from make_sir_send block:
   it should be iseq, not-tail call, no splat args, all leading args */
DEFINE_INSN
sir_cfunc_send
(CALL_DATA cd, ISEQ blockiseq)
(...)
(VALUE val)
// attr bool handles_sp = true;
// attr rb_snum_t sp_inc = sp_inc_of_sendish(cd->ci);
// attr rb_snum_t comptime_sp_inc = sp_inc_of_sendish(ci);
{
    MIRJIT_CONST_PTR(const struct rb_callcache *, cc, cd->cc);
    MIRJIT_CONST(int, argc, vm_ci_argc(cd->ci), "d");
    VALUE *argv = reg_cfp->sp - argc;
    VALUE recv = TOPN(argc);
    VALUE bh;
    struct rb_captured_block *captured;
    MIRJIT_CONST(VALUE, klass, vm_cc_class(cc), PRIxVALUE);

    if (klass != CLASS_OF(recv)) goto sir_cfunc_send_exit;
    MIRJIT_CONST_PTR(const struct rb_callable_method_entry_struct *, cme, vm_cc_cme(cc));
    VM_ASSERT(callable_method_entry_p(cme));
    MIRJIT_CONST_PTR(const rb_method_cfunc_t *, cfunc, vm_method_cfunc_entry(cme));
    RUBY_DTRACE_CMETHOD_ENTRY_HOOK(ec, cme->owner, cme->def->original_id);
    EXEC_EVENT_HOOK(ec, RUBY_EVENT_C_CALL, recv, cme->def->original_id, vm_ci_mid(cd->ci), cme->owner, Qundef);
    if (blockiseq == NULL) {
        bh = VM_BLOCK_HANDLER_NONE;
    } else {
        captured = VM_CFP_TO_CAPTURED_BLOCK(reg_cfp);
        captured->code.iseq = blockiseq;
        bh = VM_BH_FROM_ISEQ_BLOCK(captured);
    }
    vm_push_frame_1(ec, NULL, VM_FRAME_MAGIC_CFUNC | VM_FRAME_FLAG_CFRAME | VM_ENV_FLAG_LOCAL, recv,
                    bh, (VALUE)cme, 0, reg_cfp->sp, 0, 0);
    reg_cfp->sp = argv - 1; /* poping args including recv (sp before leave) */
    MIRJIT_CONST_PTR(rb_cfunc_invoker_t, invoker, cfunc->invoker);
    MIRJIT_CONST_PTR(rb_cfunc_func_t, func, cfunc->func);
    val = (*invoker)(recv, argc, reg_cfp->sp + 1, func); // can be improved by calling cfunc->func(arg ... )
    CHECK_CFP_CONSISTENCY("sir_cfunc_send");
    rb_vm_pop_frame(ec);
    EXEC_EVENT_HOOK(ec, RUBY_EVENT_C_RETURN, recv, cme->def->original_id, vm_ci_mid(cd->ci), cme->owner, val);
    RUBY_DTRACE_CMETHOD_RETURN_HOOK(ec, cme->owner, cme->def->original_id);
    goto sir_cfunc_send_end;
  sir_cfunc_send_exit:
    /* invalidate the current cc as we use cc from safe SIR: */
    if (cc != vm_cc_empty()) vm_cc_invalidate(cc);
    ABS_JUMP(rb_sir_get_safe_pc(reg_cfp, reg_pc - 3));
    ABNORMAL_END_INSN(sir_iseq_send_without_block);
  sir_cfunc_send_end:
    ;
}

DEFINE_INSN
sir_iter_start
(lindex_t func)
()
(VALUE index, VALUE res)
{
    VALUE arg = TOPN(0);
    int (*f)(VALUE, VALUE *) = (void *)func;

    if (!f(arg, &index)) goto safe_insn_restart;
    res = Qnil;
}

DEFINE_INSN
sir_iter_cont
(OFFSET dst, lindex_t func)
()
()
{
    VALUE (*f)(VALUE, VALUE) = (void *)func;
    TOPN(1) = f(TOPN(0), TOPN(1)); /* (res, index): index is fixnum */
    /* RUBY_VM_CHECK_INTS(ec); the check is done in leave of block iseq */
    JUMP(dst);
}

DEFINE_INSN
sir_iter_body
(OFFSET exit, lindex_t bbv, lindex_t func)
(...)
(...)
// attr bool handles_sp = true;
// attr bool leaf = false; /* has rb_check_array_type() */
// attr rb_snum_t sp_inc = -2;
// attr rb_snum_t comptime_sp_inc = -2;
{
    VALUE arg, ary, recv = TOPN(2), index = TOPN(1);
    long argc = 1;
    int (*f)(VALUE, VALUE, VALUE *) = (void *)func;
    if (!f(recv, index, &arg)) {
        INC_SP(-2);
        TOPN(0) = arg; /* result */
        JUMP(exit);
    } else {
        MIRJIT_CONST_PTR(struct rb_iseq_bbv *, bbv_ref, (struct rb_iseq_bbv *)bbv);
        MIRJIT_CONST_PTR(rb_iseq_t *, iseq, bbv_ref->iseq);
        MIRJIT_CONST_PTR(struct rb_iseq_constant_body *, body, iseq->body);
        MIRJIT_CONST(int, param_size, body->param.size, "d");

        VM_ASSERT(rb_simple_iseq_p(iseq));
        INC_SP(-1); /* remove res from iter_start or previous sir_iter_body */
        TOPN(-1) = GET_SELF();
        if (param_size > 1 && argc == 1 && !NIL_P(ary = rb_check_array_type(arg))) {
            long i, len = RARRAY_LEN(ary);
            MIRJIT_CONST(int, lead_num, body->param.lead_num, "d");

            CHECK_VM_STACK_OVERFLOW(GET_CFP(), lead_num);
            if (len > lead_num) len = lead_num;
            for (i=0; i < len; i++)
                TOPN(-i - 2) = RARRAY_AREF(ary, i);
            for (; i < lead_num; i++)
                TOPN(-i - 2) = Qnil;
        } else {
            VM_ASSERT(param_size == 1);
            TOPN(-2) = arg;
        }
        MIRJIT_CONST_PTR(VALUE *, start_pc, body->bbv_code + bbv_ref->bbv_start);
        MIRJIT_CONST(int, local_size, body->local_table_size - param_size, "d");
        MIRJIT_CONST(int, stack_max, body->stack_max, "d");
        MIRJIT_CONST_PTR(const struct rb_callable_method_entry_struct *, cme, bbv_ref->cme);
        vm_push_frame_1(ec, iseq, VM_FRAME_MAGIC_METHOD, GET_SELF(),
                        (VALUE)GET_EP() | 1, (VALUE)cme, start_pc,
                        reg_cfp->sp + 1 + param_size, local_size, stack_max);
        RESTORE_REGS();
        NEXT_INSN();
    }
}

DEFINE_INSN
sir_bbv_start sir_bbv_cont
(lindex_t bbv)
()
()
{
}

DEFINE_INSN
sir_bbv_jit_call
(lindex_t addr)
()
()
// attr bool leaf = false; /* has rb_check_frozen_internal() */
{
#if defined(__x86_64__)
    void (*f)(rb_execution_context_t *e) = (void*)addr;
#ifdef JRET
    asm volatile ("jmpq *%[func]" : : "r" (reg_cfp), "r" (reg_pc) , "r" (ec), [func] "a" (f)
                  : "rdx", "rcx", "rsi", "rdi", "r8", "r9", "r10", "r11", "memory");
    __builtin_unreachable ();
#else
    asm volatile ("call *%[func]" : "+r" (reg_cfp), "+r" (reg_pc) , "+r" (ec)  : [func] "a" (f)
                  : "rdx", "rcx", "rsi", "rdi", "r8", "r9", "r10", "r11", "memory");
#endif
#else
    const VALUE *(*f)(rb_execution_context_t *e, rb_control_frame_t *, const VALUE *) = (void*)addr;
    reg_pc = f(ec, reg_cfp, reg_pc);
#endif
}

