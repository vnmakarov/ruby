sir_iplusvvv sir_iminusvvv sir_imultvvv sir_idivvvv sir_imodvvv
sir_iorvvv sir_iandvvv sir_ieqvvv sir_ineqvvv
sir_iltvvv sir_igtvvv sir_ilevvv sir_igevvv
sir_fplusvvv sir_fminusvvv sir_fmultvvv sir_fdivvvv sir_fmodvvv
sir_feqvvv sir_fneqvvv sir_fltvvv sir_fgtvvv sir_flevvv sir_fgevvv
(EPDISP res, EPDISP op1, EPDISP op2)
()
()
{
