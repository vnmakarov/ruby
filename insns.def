DEFINE_INSN
sir_make_getivar
(ID id, IVC ic)
()
(VALUE val)
// attr bool leaf = false; /* has IVAR_ACCESSOR_SHOULD_BE_MAIN_RACTOR() */
{
    VALUE self = GET_SELF();
    val = vm_getinstancevariable(GET_ISEQ(), self, id, ic);
    rb_sir_change_getivar(self, GET_CFP(), ic, val);
}

/* Set value of instance variable id of self to val. */
DEFINE_INSN
sir_make_setivar
(ID id, IVC ic)
(VALUE val)
()
// attr bool leaf = false; /* has rb_check_frozen_internal() */
{
    VALUE self = GET_SELF();
    vm_setinstancevariable(GET_ISEQ(), self, id, val, ic);
    if (ic->entry != NULL) rb_sir_change_setivar(self, GET_CFP(), ic);
}

DEFINE_INSN
sir_make_send
(CALL_DATA cd, lindex_t send_info)
(...)
(VALUE val)
// attr bool handles_sp = true;
// attr rb_snum_t sp_inc = sp_inc_of_sendish(cd->ci);
// attr rb_snum_t comptime_sp_inc = sp_inc_of_sendish(ci);
{
    struct rb_sir_send_info *si = (void*)send_info;
    rb_control_frame_t *caller_cfp = GET_CFP();
    VALUE bh = (si->block_iseq == NULL ? VM_BLOCK_HANDLER_NONE
                : vm_caller_setup_arg_block(ec, GET_CFP(), cd->ci, si->block_iseq, false));
    val = vm_sendish(ec, caller_cfp, cd, bh, mexp_search_method);
    /* The insn can be already changed in a recursive call in sendish -- check it.  */
    if (caller_cfp->pc[-3] == (VALUE)sir_dispatch_table[BIN(sir_make_send)])
        rb_sir_change_send(ec, caller_cfp, cd, si);

    if (val == Qundef) {
        RESTORE_REGS();
        NEXT_INSN();
    } else if (GET_PC() != caller_cfp->pc) {
        /* we need to restore pc here as vm_sendish can redefine a
           method and we invalidate the current bbv and switched to
           safe pc. */
        SET_PC(caller_cfp->pc);
    }
}
