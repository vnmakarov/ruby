%
% # This is an ERB template that generates Ruby code that generates C code that
% # generates JIT-ed C code for VM insns used MIR-based JIT.
<%= render 'notice', locals: {
    this_file: 'is a generator of C code for each VM insn consumed by MIR-based JIT compiler',
    edit: __FILE__,
} -%>
% # Params of the JIT-ed func:
% #   ec: the 1st argument of the generated C func
% #   cfp: the 2nd argument
% #   pc: the 3rd argument
%;

<%= render 'mirjit_insns' %>
% supported_insns = get_mir_jit_insns
switch (insn_id) {
% (RubyVM::BareInstructions.to_a + RubyVM::OperandsUnifications.to_a).each do |insn|
%   next unless supported_insns.include?(insn.name)
  case BIN(<%= insn.name %>): {
% body = render_c_expr(insn.expr).gsub(/^#/, '#   ')
    if (proto_gen_p) {
        fmt_output(buff, "  VALUE *mirjit_<%= insn.name %>(void *ec, void *cfp, VALUE *pc");
% insn.opes.each_with_index do |ope, i|
        fmt_output(buff, ", <%= ope.fetch(:type) %>");
% end
% body.split("\n").each do |ln|
%   next unless /MIRJIT_CONST/ =~ ln
%   call = ln.sub(/\s*([^;]+)\s*;\s*/, '\1');
        fmt_output(buff, ", %s", <%= call.gsub(/\s*MIRJIT_CONST/, 'MIRJIT_CONST_PARAM_STR') %>);
% end
        fmt_output(buff, ");\n");
    }
% insn.opes.each_with_index do |ope, i|
%   if ope[:type] == "DBL"
    MAYBE_UNUSED(<%= ope[:decl] %>) = sir_val2dbl(operands[<%= i + 1 %>]);
%   else
    MAYBE_UNUSED(<%= ope[:decl] %>) = (<%= ope[:type] %>)operands[<%= i + 1 %>];
%   end
% end
    fmt_output(buff, "  pc = mirjit_<%= insn.name %>(ec, cfp, pc");
% call_p = false
% insn.opes.each_with_index do |ope, i|
    fmt_output(buff, ", 0x%"PRIxVALUE, operands[<%= i %>]);
%   if ope.fetch(:type) == 'CALL_DATA'
%     call_p = true
%   end
% end
% body.split("\n").each do |ln|
%   next unless /MIRJIT_CONST/ =~ ln
%   call = ln.sub(/\s*([^;]+)\s*;\s*/, '\1');
    <%= call %>;
    fmt_output(buff, ", " <%= call.gsub(/MIRJIT_CONST/, 'MIRJIT_CONST_FMT') %> "\n",
               <%= call.gsub(/MIRJIT_CONST/, 'MIRJIT_CONST_VAL') %>);
% end
    fmt_output(buff, ");\n");
% if call_p
    fmt_output(buff, "  if (pc != 0x%"PRIxVALUE ") goto exit;\n", (VALUE)next_insn_pc);
% end
    return TRUE;
  }
% end
  default:
    return FALSE;
}
