% body = render_c_expr(insn.expr).gsub(/^#/, '#   ')

VALUE *mirjit_<%= insn.name %>(rb_execution_context_t *ec, rb_control_frame_t *VM_REG_CFP, VALUE *VM_REG_PC cfp_member_attr, VALUE *exit_flag
% insn.opes.each_with_index do |ope, i|
    , <%= ope[:decl] %>
% end
% body.split("\n").each do |ln|
%   next unless /MIRJIT_CONST/ =~ ln
%   call = ln.sub(/\s*([^;]+)\s*;\s*/, '\1');
    , <%= call.gsub(/MIRJIT_CONST/, 'MIRJIT_PARAM') %>
% end
) {
    /* ###  Declare that we have just entered into an instruction. ### */
% insn.preamble.each do |konst|
<%= render_c_expr konst -%>
% end
%
% def insn_attr(insn, attr)
%   str = render_c_expr insn.attributes.select{|a| a.name == "attr_" + attr + "_" + insn.name}[0].expr
%   str = str.sub(/;\s*$/, "")
%   str = "\n" + str if /\A#/ =~ str
%   str
% end
#   define attr_witdh_<%= insn.name %> <%= insn.width -%>

#   define INSN_ATTR(x) <%= insn.call_attribute(' ## x ## ') %>
    bool leaf = <%= insn_attr(insn, "leaf") -%>;
% insn.pops.reverse_each.with_index.reverse_each do |pop, i|
    <%= pop[:decl] %> = <%= insn.cast_from_VALUE pop, "TOPN(#{i})"%>;
% end
%
% insn.rets.each do |ret|
%   next if insn.has_ope?(ret) or insn.has_pop?(ret)
    <%= ret[:decl] %>;
% end

    /* ### Instruction preambles. ### */
    if (! leaf) ADD_PC(<%= insn.width -%>);
% if insn.handles_sp?
    POPN(<%= insn_attr(insn, "popn") -%>);
% end

#   define NAME_OF_CURRENT_INSN <%= insn.name %>
% body.split("\n").each do |ln|
%   ln.gsub!(/MIR_CONST(_PTR)?[^;]+;/, '')
<%= ln.gsub(/CALL_SIMPLE_METHOD/, 'MIRJIT_CALL_SIMPLE_METHOD') %>
% end
#   undef NAME_OF_CURRENT_INSN

    /* ### Instruction trailers. ### */
    CHECK_VM_STACK_OVERFLOW_FOR_INSN(VM_REG_CFP, <%= insn_attr(insn, "retn") -%>);
% if insn.handles_sp?
%   insn.rets.reverse_each do |ret|
    PUSH(<%= insn.cast_to_VALUE ret %>);
%   end
% else
    INC_SP(<%= insn_attr(insn, "sp_inc") -%>);
%   insn.rets.reverse_each.with_index do |ret, i|
    TOPN(<%= i %>) = <%= insn.cast_to_VALUE ret %>;
    VM_ASSERT(!RB_TYPE_P(TOPN(<%= i %>), T_NONE));
    VM_ASSERT(!RB_TYPE_P(TOPN(<%= i %>), T_MOVED));
%   end
% end
    if (leaf) ADD_PC(<%= insn.width -%>);
#   undef attr_witdh_<%= insn.name %>
#   undef INSN_ATTR
    *exit_flag = 0;
   exit:
    return VM_REG_PC;
}
